---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHero from '@/components/PageHero.astro'
import AnimatedSection from '@/components/AnimatedSection.astro'
import AsciiDocContent from '@/components/AsciiDocContent.astro'
import PersonCard from '@/components/PersonCard.astro'
import { getContent } from '@/lib/content'
import { people } from '@/data/people'

const content = getContent('pages', 'about')
const title = content?.title || 'About'
---

<BaseLayout title={title} description="The Enosema Foundation facilitates the mutual understanding of entities by providing insight and clarity to concepts.">
  <PageHero eyebrow="About" title={title} crumbs={[{ label: 'Home', to: '/' }, { label: 'About' }]} width="3xl" compact />

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    {
      content ? (
        <AsciiDocContent html={content.body} />
      ) : (
        <div class="text-center py-20 text-gray-400">
          <p class="font-mono text-sm">Content not available yet.</p>
        </div>
      )
    }
  </div>

  <!-- Founders profiles -->
  <section id="founders" class="bg-gray-50 dark:bg-pine-light/30 border-t border-gray-200/60 dark:border-gray-800/60 py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <AnimatedSection>
        <div class="text-center mb-12">
          <p class="font-mono text-xs tracking-[0.2em] uppercase text-eno-green dark:text-eno-green-light mb-3">Profiles</p>
          <h2 class="text-2xl sm:text-3xl font-serif font-bold text-gray-900 dark:text-white">The founders</h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto text-sm leading-relaxed">
            Terminology and concept-management experts from the ISO and IEC communities,
            who maintain some of the most widely used standardized terminology datasets.
          </p>
        </div>
      </AnimatedSection>
      <div class="grid md:grid-cols-3 gap-6">
        {
          people.map((person, i) => (
            <AnimatedSection delay={i * 80}>
              <PersonCard person={person} />
            </AnimatedSection>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
