---
import BaseLayout from '@/layouts/BaseLayout.astro'
import BaseButton from '@/components/BaseButton.astro'
---

<BaseLayout title="Page not found">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-32 text-center">
    <p class="font-mono text-7xl font-bold text-eno-green-dark dark:text-eno-green-light">404</p>
    <h1 class="mt-6 text-2xl font-serif font-bold text-gray-900 dark:text-white">Page not found</h1>
    <p class="mt-3 text-gray-500 dark:text-gray-400">
      The concept you are looking for is not defined at this address.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <BaseButton to="/" size="md">Back to home</BaseButton>
      <BaseButton to="/blog" variant="secondary" size="md">Read the blog</BaseButton>
    </div>
  </div>
</BaseLayout>
