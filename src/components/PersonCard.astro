---
import type { Person } from '@/data/people'

interface Props {
  person: Person
}

const { person } = Astro.props
const initial = person.name.charAt(0)
---

<div class="relative rounded-xl border border-gray-200/80 dark:border-gray-700/60 bg-white dark:bg-pine-light transition-all duration-200 hover:border-eno-green/30 dark:hover:border-eno-green/30 hover:-translate-y-0.5 hover:shadow-lg p-6 h-full flex flex-col">
  <div class="mb-4">
    {
      person.photo ? (
        <img src={person.photo} alt={person.name} width="56" height="56" class="w-14 h-14 rounded-full object-cover" />
      ) : (
        <div class="w-14 h-14 rounded-full bg-eno-green/8 dark:bg-eno-green/10 flex items-center justify-center">
          <span class="font-serif font-bold text-xl text-eno-green dark:text-eno-green-light">{initial}</span>
        </div>
      )
    }
  </div>
  <h3 class="font-serif font-bold text-lg text-gray-900 dark:text-white">{person.name}</h3>
  <p class="font-mono text-xs text-eno-green dark:text-eno-green-light tracking-wide mt-1">{person.role}</p>
  <p class="mt-3 text-sm text-gray-500 dark:text-gray-400 leading-relaxed flex-1">{person.blurb}</p>
  {
    person.links && person.links.length > 0 && (
      <ul class="mt-4 pt-4 border-t border-gray-100 dark:border-gray-700/60 space-y-1.5">
        {person.links.map((link) => (
          <li>
            <a href={link.href} target="_blank" rel="noopener" class="relative z-10 inline-flex items-center gap-1.5 text-xs font-medium text-gray-500 dark:text-gray-400 hover:text-eno-green dark:hover:text-eno-green-light transition-colors">
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" /></svg>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )
  }
  <a href={`/people/${person.slug}/`} class="absolute inset-0" aria-label={`${person.name} profile`}></a>
</div>
